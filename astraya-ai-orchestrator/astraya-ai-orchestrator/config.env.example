# Copy this file as config.env and fill in the keys.
# Keep this file LOCAL. It is ignored by the package's .gitignore.

OPENAI_API_KEY=
CURSOR_API_KEY=

# codex = use the local ChatGPT-authenticated Codex CLI for Director/Reviewer.
# openai = use OPENAI_API_KEY and OPENAI_DIRECTOR_MODEL instead.
DIRECTOR_BACKEND=codex
CODEX_COMMAND=codex

# This package currently lives one extra directory deep inside the repo.
REPO_PATH=../..

# Text model used as Director + Reviewer.
OPENAI_DIRECTOR_MODEL=gpt-5.5

# Image model used for candidate art generation.
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Overnight safety limits.
MAX_TASKS_PER_RUN=8
MAX_FIX_ROUNDS=3
MAX_ASSETS_PER_RUN=8

# Work is isolated here. Main is never merged automatically.
BRANCH_PREFIX=ai/nightly

# 1 = push the nightly branch to origin after each successful commit.
AUTO_PUSH=1

# Asset candidates are NEVER promoted to production automatically by default.
ENABLE_ASSET_GENERATION=0
AUTO_PROMOTE_ASSETS=0

# Cursor CLI executable.
CURSOR_AGENT_COMMAND=agent

# Cursor model: leave blank to use Cursor Auto.
CURSOR_MODEL=

# 1 = abort if repo has uncommitted changes before starting.
REQUIRE_CLEAN_WORKTREE=1

# Deterministic local verification run after every Cursor commit.
VALIDATION_COMMAND=py tools/validate_static_client.py
