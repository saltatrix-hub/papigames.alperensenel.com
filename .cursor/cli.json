{
  "version": 1,
  "permissions": {
    "allow": [
      "Read(**)",
      "Write(js/**)",
      "Write(css/**)",
      "Write(assets/**)",
      "Write(design/**)",
      "Write(ai/**)",
      "Write(tools/**)",
      "Write(.cursor/**)",
      "Write(AGENTS.md)",
      "Write(README.md)",
      "Write(index.html)",
      "Shell(node)",
